{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tooltip",
  "description": "轻量文字提示组件，用于解释元素含义，内容不可交互。",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "提示内容（也支持 ReactNode），建议为纯文本"
    },
    "children": {
      "description": "触发提示的子元素"
    },
    "show": {
      "type": "boolean",
      "description": "受控模式下的显示状态"
    },
    "trigger": {
      "type": "string",
      "enum": ["hover", "click"],
      "default": "hover",
      "description": "触发方式"
    },
    "theme": {
      "type": "string",
      "enum": ["light", "dark"],
      "default": "dark",
      "description": "颜色主题"
    },
    "placement": {
      "type": "string",
      "enum": ["top", "bottom", "left", "right"],
      "default": "top",
      "description": "提示位置"
    },
    "hideArrow": {
      "type": "boolean",
      "default": false,
      "description": "是否隐藏箭头"
    },
    "maxWidth": {
      "type": ["number", "string"],
      "default": 240,
      "description": "提示最大宽度，超出后换行"
    },
    "attach": {
      "type": "string",
      "enum": ["parent", "body"],
      "default": "parent",
      "description": "提示挂载层级：parent-父容器、body-body元素"
    },
    "className": {
      "type": "string",
      "description": "根容器自定义类名"
    },
    "style": {
      "type": "object",
      "description": "根容器自定义样式"
    },
    "tooltipClassName": {
      "type": "string",
      "description": "气泡自定义类名"
    },
    "tooltipStyle": {
      "type": "object",
      "description": "气泡自定义样式"
    },
    "onVisibleChange": {
      "type": "string",
      "description": "显示状态变化回调：(visible: boolean) => void"
    }
  },
  "examples": [
    {
      "description": "基础用法 - 悬停显示",
      "code": "<Tooltip content=\"提示内容\"><Button>悬停显示</Button></Tooltip>"
    },
    {
      "description": "不同位置",
      "code": "<Tooltip placement=\"bottom\" content=\"底部显示\"><span>底部</span></Tooltip>"
    },
    {
      "description": "浅色主题",
      "code": "<Tooltip theme=\"light\" content=\"浅色提示\"><span>浅色</span></Tooltip>"
    },
    {
      "description": "隐藏箭头",
      "code": "<Tooltip hideArrow content=\"无箭头提示\"><span>无箭头</span></Tooltip>"
    },
    {
      "description": "挂载到 body",
      "code": "<Tooltip attach=\"body\" content=\"挂载到body\"><Button>Body挂载</Button></Tooltip>"
    }
  ]
}
